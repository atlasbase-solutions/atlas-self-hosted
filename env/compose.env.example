# Docker Compose model settings. This file is read by Docker Compose itself.
ATLAS_VERSION=1.1.1
# How the edge faces the internet:
#   direct -- the default for a server of its own. The edge listens on ports 80
#             and 443 and obtains and renews TLS certificates for the portal
#             and tracking domains itself (ACME: HTTP-01 on 80, TLS-ALPN on
#             443). Both ports must be reachable from the internet.
#   proxy  -- your TLS proxy or load balancer terminates TLS and forwards plain
#             HTTP to ATLAS_HTTP_PORT. Set ATLAS_HTTP_PORT=8080 (or any free
#             port), ATLAS_HTTPS_BIND=127.0.0.1 and an EMPTY ATLAS_HTTPS_PORT,
#             and name the proxy network in env/edge.env.
ATLAS_EDGE_MODE=direct
ATLAS_HTTP_BIND=0.0.0.0
ATLAS_HTTP_PORT=80
ATLAS_HTTPS_BIND=0.0.0.0
# Empty means "no fixed host port": Docker then binds a random port on
# ATLAS_HTTPS_BIND, which nothing listens on in `proxy` mode.
ATLAS_HTTPS_PORT=443
