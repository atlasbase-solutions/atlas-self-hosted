# Runtime settings for the Atlas Tracking Gateway and its migrator only.
#
# NOTE ON LICENSING: without a confirmed license this installation does not
# serve traffic. See the "Licensing" section in README.md.
HTTP_ADDR=:8080
# Metrics listen on their OWN address and are never published by the edge: the
# tracking host faces the internet, and /metrics there would hand out traffic
# volumes, refusal rates and anti-fraud signals to anyone. Point Prometheus at
# this address inside the installation network. It must differ from HTTP_ADDR.
METRICS_ADDR=:9108
# Subnet of this installation's own network, whose proxy headers the tracking
# service believes. Leave it as it is unless you changed the Compose network.
TRUSTED_PROXY_CIDRS=172.29.0.0/24
# Subnet of an EXTERNAL TLS proxy or load balancer in front of Atlas, if you run
# one. Kept separate from the line above because operators kept replacing the
# installation's own subnet with their balancer instead of adding it, which
# makes every visitor look like one address -- rate limits, click uniqueness,
# geo and the hardened-postback IP allowlist then all see the balancer. A
# network wider than /16 (IPv4) or /64 (IPv6) is refused at startup: name the
# balancer's own subnet, never a whole private range.
EXTERNAL_PROXY_CIDRS=
PG_DSN=postgres://atlas_gateway:CHANGE_ME_GATEWAY_DB@gateway-postgres:5432/atlas_gateway?sslmode=disable
CLICKHOUSE_DSN=http://atlas_gateway:CHANGE_ME_CLICKHOUSE@clickhouse:8123/atlas_gateway
REDIS_ADDR=redis:6379
KAFKA_BROKERS=kafka:19092
CONFIG_CONSUMER_GROUP_ID=gateway-config
CONFIG_CONSUMER_ASSIGNMENT_TIMEOUT=3m
EVENT_SINK=kafka
DATACENTER_ASN_FILE=/usr/share/atlas-gateway/enrichment/datacenter-asns.txt
UA_REGEXES_FILE=/usr/share/atlas-gateway/enrichment/uap-core-v0.18.0-regexes.yaml
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=10s
SHUTDOWN_LAMEDUCK=5s
DEPENDENCY_TIMEOUT=2s
KAFKA_PRODUCE_TIMEOUT=200ms
KAFKA_BATCH_SIZE=500
KAFKA_BATCH_TIMEOUT=5ms
SNAPSHOT_RECONCILE_INTERVAL=60s
CLICK_CONTEXT_TTL=2160h
ATTRIBUTION_WINDOW=2160h
UNIQUE_CLICK_WINDOW=24h
# Window that makes an impression "unique". Deliberately shorter than the click
# one: impression repeats worth observing (page refresh, prefetch, reopened tab,
# webview) happen within minutes, and a 24h window would hold orders of
# magnitude more Redis keys for the same answer. A reporting figure only -- CPM
# accrual, impression caps and the plan volume keep counting every impression.
UNIQUE_IMPRESSION_WINDOW=1h
# TTL of the cached publisher->offer grant. This is an access-control
# safeguard, not a memory setting: a cache hit is terminal, so without an
# expiry a revoked access would keep working until Redis restarts. A denial is
# never cached, so nothing extends the window further.
PUBLISHER_ACCESS_TTL=5m
# TTL of a cached promo code. It bounds how long a changed or disabled code can
# keep attributing by its old offer, partner and status.
PROMO_CACHE_TTL=5m
# TTL of the player-to-partner binding cache. PostgreSQL is the source of truth
# and a miss is read through, so this only decides how long an INACTIVE player
# keeps occupying memory: any postback for that player rewrites the key and
# restarts the TTL. Without a TTL the cache would grow with every external id
# ever seen and never shrink.
BINDING_CACHE_TTL=720h
# How often this container measures the consumer lag of its OWN Kafka groups
# against the broker, exported as atlas_gateway_consumer_lag. This is the only
# signal for a worker that is alive but processes nothing: a reader that joined
# its group before the topic existed holds no partitions and blocks forever
# without raising an error or turning readiness red.
CONSUMER_LAG_INTERVAL=30s
HMAC_TIMESTAMP_WINDOW=5m
NONCE_TTL=10m
ATLAS_CONFIG_SECRET_KEY=CHANGE_ME_SHARED_CONFIG_SECRET
ATLAS_CONFIG_SECRET_KEY_PREVIOUS=
CLICK_RATE_LIMIT_RPS=1000
# Own ceiling for the CPM pixel, deliberately separate from the click one:
# there are orders of magnitude more impressions than clicks, so a single
# shared value would force a choice between throttling display traffic and
# leaving clicks unlimited. Per tenant and client IP, same as the click.
IMPRESSION_RATE_LIMIT_RPS=2000
# Postback requests per second per tenant and offer, enforced before
# attribution.
POSTBACK_RATE_LIMIT_RPS=100
# Early ceiling on /postback requests per second from ONE client address,
# checked before the request is parsed; 0 turns it off. Raise it if one
# advertiser server sends more postbacks than this across all its offers.
POSTBACK_IP_RATE_LIMIT_RPS=300
# Maximum individual rejected-postback trail events per tenant and offer each
# minute. The trail is what lets an integrator see WHY a postback was refused;
# the ceiling keeps a misconfigured sender from filling the journal.
POSTBACK_REJECTED_EVENT_LIMIT_PER_MINUTE=10
CLICK_SPILL_ENABLED=true
IMPRESSION_SPILL_ENABLED=true
IMPRESSION_SPILL_QUEUE_LIMIT=500000
OUTBOUND_NO_RECIPIENT_WINDOW=10m

# Extra destination networks an outbound postback may reach. Empty is the
# normal state: the sender connects only to globally routable unicast addresses
# (private, loopback, link-local, carrier-grade NAT 100.64.0.0/10, reserved and
# multicast ranges are refused), so a postback URL cannot reach your internal
# network or a cloud metadata endpoint. Set the same value in portal.env. Add entries only when the conversion receiver
# legitimately lives inside the same private network as this installation. The
# check runs on the address the transport is about to connect to, so a hostname
# that resolves inside is refused too. Never use 0.0.0.0/0 -- that disables the
# filter entirely.
OUTBOUND_ALLOWED_TARGET_CIDRS=

# How often and in what batches the reaper returns expired outbound-delivery
# leases to circulation. The interval sets how long recovery takes
# after a pod dies mid-delivery: a longer interval delays the retry, a shorter
# one adds constant load on an otherwise idle table.
OUTBOUND_LEASE_REAPER_INTERVAL=30s
OUTBOUND_LEASE_REAPER_BATCH_SIZE=500

# Upper bound on this process's PostgreSQL pool. Replicas x pool size must fit
# into the server's max_connections with room left for migrations, operator
# commands and the other services of the installation.
PG_POOL_MAX_CONNS=20

# --- Self-hosted license ---------------------------------------------------
# Without a confirmed license this installation does not serve traffic.
# Health and /version keep answering either way. See the "Licensing" section
# of README.md for how to obtain and activate a license.
#
# Keep the same license and the same values of these variables in
# portal.env and gateway.env: each service checks the license itself.
#
# ATLAS_LICENSE_TOKEN is the license string from your Atlas manager. Leave it
# EMPTY to activate the license in the portal instead -- the recommended path
# for Docker Compose. When set, it wins over the license installed in the
# portal, which then cannot be replaced or removed there.
ATLAS_LICENSE_TOKEN=
# ATLAS_LICENSE_FILE points at a mounted offline license file inside this
# container (see the commented mounts in docker-compose.yml). Needed only
# together with ATLAS_LICENSE_ISOLATED below, or when Atlas support asks for it.
ATLAS_LICENSE_FILE=
# Where the license activated in the portal is kept, inside the shared
# `atlas-license` volume. Keep the same path in portal.env and gateway.env.
# An empty or missing file means "not activated yet", not a startup error.
ATLAS_LICENSE_TOKEN_FILE=/var/lib/atlas/license/license.token
# ATLAS_INSTALLATION_FILE is installation.json, the portal's projection of the
# installation's domains, read from the shared `atlas-installation` volume. The
# domains set in this file's ATLAS_LICENSE_*_DOMAIN(S) still win over it.
ATLAS_INSTALLATION_FILE=/var/lib/atlas/installation/installation.json
# ATLAS_LICENSE_ISOLATED=true is for installations with no outbound internet
# access at all; it requires an offline license file in ATLAS_LICENSE_FILE.
# Ask your Atlas contact before enabling it.
ATLAS_LICENSE_ISOLATED=false
# ATLAS_LICENSE_PORTAL_DOMAIN / ATLAS_LICENSE_TRACKING_DOMAINS /
# ATLAS_LICENSE_POSTBACK_DOMAIN (the last two further below) declare this
# installation's own domains. They must be exactly the domains the license was
# issued for; Settings -> License shows any mismatch.
#
# Leave them EMPTY on this Docker Compose stack: the domains entered in the
# first-run wizard reach this service through installation.json
# (ATLAS_INSTALLATION_FILE above). When you do set them, they WIN over the
# wizard; use exactly the domains the license was issued for, and the same
# values as in portal.env.
#
# Without ATLAS_INSTALLATION_FILE (the Kubernetes reference manifests), the
# portal and tracking domains are REQUIRED as soon as a license is supplied:
# the gateway refuses to start without them and names the missing variables.
ATLAS_LICENSE_PORTAL_DOMAIN=
# Legacy single tracking domain, still read as a one-item list; prefer
# ATLAS_LICENSE_TRACKING_DOMAINS below.
ATLAS_LICENSE_TRACKING_DOMAIN=

# --- Logging ---------------------------------------------------------------
# Logs go to stdout, to a daily file on disk, or to both. On this Compose stack
# stdout is picked up by the container log driver, which docker-compose.yml
# caps in size and count -- click intake alone can otherwise fill a disk.
#
# The file name always carries the calendar day. After midnight the process
# opens the next file and stops holding yesterday's open, so the installation's
# own archiving service can compress, move or delete it as an ordinary static
# file: a logrotate entry needs only the glob, olddir, compress and maxage --
# copytruncate and reopen signals are wrong here. The product itself rotates,
# compresses and deletes nothing.
#   stdout - container operation, the collector reads the stream (default)
#   file   - only the file on disk
#   both   - both channels at once
#   none   - logging off
ATLAS_LOG_SINK=stdout
# json is read by a log collector, text by a human in a terminal.
ATLAS_LOG_FORMAT=json
# Minimum level, shared by both channels: debug, info, warn or error. An unknown
# value stops the service at startup instead of silently falling back to info.
ATLAS_LOG_LEVEL=info
# Directory for the daily files. Required when ATLAS_LOG_SINK is file or both,
# and it must be a mounted volume -- see the commented `logs` mount in
# docker-compose.yml. The directory is created 0750 and the files 0640, because
# the records hold user agents and click identifiers; the raw client address is
# never written to the log. Services do not run as root (uid 10001), and a
# freshly created volume belongs to root, so hand ownership over BEFORE the
# first start with a file channel -- otherwise the service stops with
# "permission denied" and the file name in the message.
# `<service>.log` in the same directory is a symlink to the current day, so
# `tail -F` survives midnight.
ATLAS_LOG_DIR=
# Instance discriminator in the file name; defaults to the host name. Keeps two
# replicas sharing one directory from writing into the same file.
ATLAS_LOG_INSTANCE=
# Zone for BOTH the day boundary in the file name and the timestamps inside the
# records -- one setting, so a file dated the 25th never holds records dated the
# 26th.
ATLAS_LOG_TIME_ZONE=UTC
# Delete our own files older than N days. 0 (default) disables it: where an
# archiving service is configured, the product must not compete with it. Set it
# only as a safety net for an installation that has no such service -- nothing
# limits the size of a SINGLE day, and a full intake log can reach tens of
# gigabytes within one.
ATLAS_LOG_KEEP_DAYS=0
# HTTP access log of the intake stream: off (default), sampled or full. It is
# off deliberately -- at 5000 RPS one replica writes roughly 1.5 MB/s, which is
# what fills a log volume within a day.
ATLAS_ACCESS_LOG=off
# In sampled mode: write every Nth record.
ATLAS_ACCESS_LOG_SAMPLE=100

# Tracking hosts that accept clicks and impressions, comma-separated, and the
# optional separate host that accepts server-to-server postbacks. A click host
# answers 404 to /postback and a postback host answers 404 to clicks, so a
# click domain that lands on an ad-blocker list does not stop conversion
# intake. Without a postback host, postbacks are accepted on the tracking
# hosts. Leave both empty to use the wizard's domains (see the license section
# above). Configure the edge and any external TLS proxy for every additional
# host name before sending traffic to it.
ATLAS_LICENSE_TRACKING_DOMAINS=
ATLAS_LICENSE_POSTBACK_DOMAIN=

# Signed reputation packages: Portal writes the parent volume; Gateway reads it.
ATLAS_ANTIFRAUD_FEED_DIR=/var/lib/atlas/antifraud/current
# Interval for reloading and verifying the shared reputation package.
ANTIFRAUD_FEED_RELOAD_INTERVAL=5m
