# Runtime settings for the Atlas Portal API container only.
#
# NOTE ON LICENSING (see the "Licensing" section in README.md): this
# installation does not serve /api, /internal, or /s2s traffic without a
# confirmed license. Read that section before going further than a local
# evaluation.
PORTAL_HTTP_ADDR=:11082
# NOTE ON THE EDITION: there is no variable that selects it. This distribution is
# the self-hosted edition because that is how its binaries were BUILT, and a
# `PORTAL_EDITION` line here makes the portal refuse to start, naming the
# variable and the edition of the binary. `GET /version` reports the edition of
# the running process, which is the reliable way to confirm what you deployed.
PORTAL_DATABASE_URL=postgres://atlas_portal:CHANGE_ME_PORTAL_DB@portal-postgres:5432/atlas_portal?sslmode=disable
# The first Network Owner. Leave BOTH empty (the default): the portal then
# starts in setup mode and the owner is created in the browser, in the
# first-run wizard opened with a setup code (`atlas-setup-code`). Set BOTH to
# have the owner created at startup instead; the wizard is then skipped. The
# password set here is temporary -- the owner has to replace it at the first
# sign-in. Setting only one of the two stops the portal at startup.
PORTAL_OWNER_EMAIL=
PORTAL_OWNER_PASSWORD=
# Encryption keys below must be exactly 32 random bytes, written in hex or
# base64: generate each with `openssl rand -hex 32`. A passphrase is refused at
# startup.
PORTAL_SECRET_KEY=CHANGE_ME_RANDOM_SMTP_ENCRYPTION_KEY
# Previous value of PORTAL_SECRET_KEY, kept only while a key rotation is in
# progress: secrets sealed before the rotation stay readable and invitation
# links issued before it keep being accepted. Nothing is ever sealed with it.
# Re-encrypt the stored secrets with
#   docker compose --env-file env/compose.env run --rm \
#     --entrypoint atlas-rotate-secrets portal
# and only then clear this line. Dropping it too early makes not-yet-rotated
# secrets unreadable, and invitations not yet accepted have to be reissued by
# hand, because an invitation token is a signature that is stored nowhere.
PORTAL_SECRET_KEY_PREVIOUS=
ATLAS_CONFIG_SECRET_KEY=CHANGE_ME_SHARED_CONFIG_SECRET
ATLAS_CONFIG_SECRET_KEY_PREVIOUS=
# Extra browser origins allowed to call the API. The portal SPA is served by
# the edge on the portal's own domain (same origin), so leave it empty unless
# you host another front end.
PORTAL_CORS_ORIGIN=
# Subnet of this installation's own network, whose proxy headers the portal
# believes. Leave it as it is unless you changed the Compose network.
PORTAL_TRUSTED_PROXY_CIDRS=172.29.0.0/24
# Subnet of an EXTERNAL TLS proxy or load balancer in front of Atlas, if you run
# one. Kept separate from the line above because operators kept replacing the
# installation's own subnet with their balancer instead of adding it, which
# makes every visitor look like one address -- rate limits, click uniqueness,
# geo and the hardened-postback IP allowlist then all see the balancer. A
# network wider than /16 (IPv4) or /64 (IPv6) is refused at startup: name the
# balancer's own subnet, never a whole private range.
PORTAL_EXTERNAL_PROXY_CIDRS=
PORTAL_SHUTDOWN_LAMEDUCK=5s
PORTAL_SHUTDOWN_TIMEOUT=10s
# Address of the portal used in links sent by email. Leave it EMPTY: it is
# then https://<portal domain> from the first-run wizard (or from
# ATLAS_LICENSE_PORTAL_DOMAIN below). Set it only to override that address.
PORTAL_APP_URL=
PORTAL_APP_SCHEME=https
PORTAL_APP_PORT=
# Tracking domain printed in partner links. Leave it EMPTY: the first-run
# wizard stores the tracking domain. A value here is treated as set by the
# server configuration -- the wizard then shows it read-only.
PORTAL_TRACKING_DOMAIN=
PORTAL_TRACKING_PORT=
PORTAL_NETWORK_NAME=Atlas
PORTAL_DEFAULT_TZ=UTC
PORTAL_INVITE_TTL_HOURS=168
PORTAL_SETUP_TTL_HOURS=72
# How long a password ISSUED BY SOMEBODY ELSE stays usable, in hours (default
# 168 = 7d). Such a password is single-use: the session it opens can do nothing
# but replace it, and after this window the sign-in is refused and access has to
# be issued again. A password the person chose themselves never expires.
PORTAL_TEMP_PASSWORD_TTL_HOURS=168
PORTAL_FILE_STORAGE_DIR=/var/lib/atlas/portal-files
PORTAL_FILE_MAX_SIZE_MB=50
PORTAL_MAX_STORAGE_MB=0
PORTAL_MAX_PUBLISHERS=0
PORTAL_MAX_OFFERS=0
PORTAL_MAX_ADVERTISERS=0
PORTAL_PROMO_CODES_ENABLED=true
PORTAL_MAX_PROMO_CODES=0
PORTAL_API_PERSONAL_KEYS=true
PORTAL_API_SERVICE_KEYS=true
PORTAL_API_SERVICE_KEYS_MAX=0
PORTAL_API_RATE_LIMIT_RPM=0
PORTAL_API_RATE_LIMIT_RPM_TENANT=0
PORTAL_API_RATE_LIMIT_RPM_HEAVY=0
PORTAL_API_REQUIRE_HTTPS=true
PORTAL_CLICKHOUSE_URL=http://atlas_gateway:CHANGE_ME_CLICKHOUSE@clickhouse:8123/atlas_gateway
PORTAL_ANALYTICS_TENANT_ID=1
PORTAL_KAFKA_BROKERS=kafka:19092

# --- Self-hosted license ---------------------------------------------------
# Without a confirmed license this installation does not serve traffic.
# Health and /version keep answering either way. See the "Licensing" section
# of README.md for how to obtain and activate a license.
#
# Keep the same license and the same values of these variables in
# portal.env and gateway.env: each service checks the license itself.
#
# ATLAS_LICENSE_TOKEN is the license string from your Atlas manager. Leave it
# EMPTY to activate the license in the portal instead -- the recommended path
# for Docker Compose. When set, it wins over the license installed in the
# portal, which then cannot be replaced or removed there.
ATLAS_LICENSE_TOKEN=
# ATLAS_LICENSE_FILE points at a mounted offline license file inside this
# container (see the commented mounts in docker-compose.yml). Needed only
# together with ATLAS_LICENSE_ISOLATED below, or when Atlas support asks for it.
ATLAS_LICENSE_FILE=
# Where the license activated in the portal is kept, inside the shared
# `atlas-license` volume. Keep the same path in portal.env and gateway.env.
# An empty or missing file means "not activated yet", not a startup error.
ATLAS_LICENSE_TOKEN_FILE=/var/lib/atlas/license/license.token
# ATLAS_INSTALLATION_FILE is where the portal writes installation.json, its
# projection of the installation's domains (portal, tracking, postback), the
# first-run wizard state and the owner's address for certificate expiry
# notices. The edge and Gateway read it from the shared `atlas-installation`
# volume. The file is rebuilt from the database at every start; never edit it.
# Domains set in this file's ATLAS_LICENSE_*_DOMAIN(S) still win over it.
ATLAS_INSTALLATION_FILE=/var/lib/atlas/installation/installation.json
# Public addresses of this server, comma-separated. The first-run wizard shows
# them as the A/AAAA values to create at your DNS registrar. The installer
# fills this in from the host's network interfaces; empty is fine.
ATLAS_PUBLIC_IPS=
# The edge's HTTPS listener inside this Compose network. In `direct` mode the
# first-run wizard connects to it with the domain's name to see whether the
# certificate has been issued yet. Keep the default unless you renamed the
# `edge` service; it is not used in `proxy` mode.
PORTAL_EDGE_TLS_ADDR=edge:443
# ATLAS_LICENSE_ISOLATED=true is for installations with no outbound internet
# access at all; it requires an offline license file in ATLAS_LICENSE_FILE.
# Ask your Atlas contact before enabling it.
ATLAS_LICENSE_ISOLATED=false
# ATLAS_LICENSE_PORTAL_DOMAIN / ATLAS_LICENSE_TRACKING_DOMAINS /
# ATLAS_LICENSE_POSTBACK_DOMAIN (the last two further below) declare this
# installation's own domains. They must be exactly the domains the license was
# issued for; Settings -> License shows any mismatch.
#
# Leave them EMPTY on this Docker Compose stack: the domains entered in the
# first-run wizard are stored in the portal database and reach the Gateway and
# the edge through installation.json (ATLAS_INSTALLATION_FILE above). When you
# do set them, they WIN over the wizard, which then shows them read-only; set
# them to exactly the domains the license was issued for, and keep the same
# values in gateway.env.
#
# Without ATLAS_INSTALLATION_FILE (the Kubernetes reference manifests), the
# portal and tracking domains are REQUIRED as soon as a license is supplied:
# the portal refuses to start without them and names the missing variables.
# An empty tracking list falls back to PORTAL_TRACKING_DOMAIN.
ATLAS_LICENSE_PORTAL_DOMAIN=
# Legacy single tracking domain, still read as a one-item list; prefer
# ATLAS_LICENSE_TRACKING_DOMAINS below.
ATLAS_LICENSE_TRACKING_DOMAIN=

# --- Logging ---------------------------------------------------------------
# Logs go to stdout, to a daily file on disk, or to both. On this Compose stack
# stdout is picked up by the container log driver, which docker-compose.yml
# caps in size and count -- click intake alone can otherwise fill a disk.
#
# The file name always carries the calendar day. After midnight the process
# opens the next file and stops holding yesterday's open, so the installation's
# own archiving service can compress, move or delete it as an ordinary static
# file: a logrotate entry needs only the glob, olddir, compress and maxage --
# copytruncate and reopen signals are wrong here. The product itself rotates,
# compresses and deletes nothing.
#   stdout - container operation, the collector reads the stream (default)
#   file   - only the file on disk
#   both   - both channels at once
#   none   - logging off
ATLAS_LOG_SINK=stdout
# json is read by a log collector, text by a human in a terminal.
ATLAS_LOG_FORMAT=json
# Minimum level, shared by both channels: debug, info, warn or error. An unknown
# value stops the service at startup instead of silently falling back to info.
ATLAS_LOG_LEVEL=info
# Directory for the daily files. Required when ATLAS_LOG_SINK is file or both,
# and it must be a mounted volume -- see the commented `logs` mount in
# docker-compose.yml. The directory is created 0750 and the files 0640, because
# the records hold user agents and click identifiers; the raw client address is
# never written to the log. Services do not run as root (uid 10001), and a
# freshly created volume belongs to root, so hand ownership over BEFORE the
# first start with a file channel -- otherwise the service stops with
# "permission denied" and the file name in the message.
# `<service>.log` in the same directory is a symlink to the current day, so
# `tail -F` survives midnight.
ATLAS_LOG_DIR=
# Instance discriminator in the file name; defaults to the host name. Keeps two
# replicas sharing one directory from writing into the same file.
ATLAS_LOG_INSTANCE=
# Zone for BOTH the day boundary in the file name and the timestamps inside the
# records -- one setting, so a file dated the 25th never holds records dated the
# 26th.
ATLAS_LOG_TIME_ZONE=UTC
# Delete our own files older than N days. 0 (default) disables it: where an
# archiving service is configured, the product must not compete with it. Set it
# only as a safety net for an installation that has no such service -- nothing
# limits the size of a SINGLE day, and a full intake log can reach tens of
# gigabytes within one.
ATLAS_LOG_KEEP_DAYS=0

# Tracking hosts that accept clicks and impressions, comma-separated, and the
# optional separate host that accepts server-to-server postbacks. A click host
# answers 404 to /postback and a postback host answers 404 to clicks, so a
# click domain that lands on an ad-blocker list does not stop conversion
# intake. Without a postback host, postbacks are accepted on the tracking
# hosts. Leave both empty to use the wizard's domains (see the license section
# above). Configure the edge and any external TLS proxy for every additional
# host name before sending traffic to it.
ATLAS_LICENSE_TRACKING_DOMAINS=
ATLAS_LICENSE_POSTBACK_DOMAIN=

# Signed reputation packages: Portal writes the parent volume; Gateway reads it.
ATLAS_ANTIFRAUD_FEED_DIR=/var/lib/atlas/antifraud/current
# The subscription endpoint is built into Portal (https://antifraud.getatlasbase.com)
# and is not configurable; allow outbound HTTPS to it when the subscription is on.

# Internal networks the portal may reach at an address a portal user entered
# (the conversion receiver test event, the SMTP server) in addition to public
# addresses. Must carry the same value as in gateway.env. An SMTP server on a
# port other than 25, 465, 587 or 2525 is reachable only inside these networks.
# Empty is the normal state; never 0.0.0.0/0.
OUTBOUND_ALLOWED_TARGET_CIDRS=

# PORTAL_GATEWAY_INTERNAL_URL is where the portal reads the Gateway's license
# state (`GET /license/state` on the Gateway's internal metrics listener,
# METRICS_ADDR in gateway.env). Settings → License and the activation screen
# use it to show whether traffic intake has confirmed the license. It must be
# reachable only on the private network; the public tracking port does not
# serve it. Empty means the default below.
PORTAL_GATEWAY_INTERNAL_URL=http://gateway:9108
